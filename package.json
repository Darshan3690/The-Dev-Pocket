{
  "name": "vibeci",
  "version": "0.1.2",
  "description": "The CI seatbelt for vibe coding and AI coding agents. Pre-PR CI Twin intelligence, cross-platform gap detection, and anti-cheat repair verification.",
  "type": "module",
  "bin": {
    "vibeci": "dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --clean --shims",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "web": "npx -y serve ."
  },
  "keywords": [
    "ci",
    "vibeci",
    "vibe-coding",
    "github-actions",
    "ai-agents",
    "mcp",
    "cursor",
    "claude-code",
    "antigravity",
    "devtools"
  ],
  "author": "Darshan Rajput <darshan.rajput369@gmail.com> (https://github.com/Darshan3690)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "execa": "^10.2.1",
    "fast-glob": "^3.3.3",
    "ora": "^10.0.0",
    "simple-git": "^4.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "vitest": "^5.1.1"
  }
}
